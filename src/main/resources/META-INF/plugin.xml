<idea-plugin>
    <id>com.ritenoar.aloudrite</id>
    <name>AloudRite</name>
    <vendor>Ritenoar</vendor>
    <description>Reads Markdown and agentic coding documents aloud inside the IDE.</description>

    <depends>com.intellij.modules.platform</depends>

    <actions>
        <action id="com.ritenoar.aloudrite.SayHello" class="com.ritenoar.aloudrite.SayHelloAction" text="Say Hello">
            <add-to-group group-id="ToolsMenu"/>
        </action>
    </actions>
</idea-plugin>
