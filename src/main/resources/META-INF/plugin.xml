<idea-plugin>
    <id>com.ritenoar.aloudrite</id>
    <name>AloudRite</name>
    <vendor>Ritenoar</vendor>
    <description>Reads Markdown and agentic coding documents aloud inside the IDE.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="AloudRite" displayType="BALLOON"/>
        <toolWindow id="AloudRite" anchor="right" icon="/icons/toolWindow.svg" doNotActivateOnStart="true"
                    factoryClass="com.ritenoar.aloudrite.ReadingToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="com.ritenoar.aloudrite.ReadingSpeed" displayName="AloudRite"
                                 instance="com.ritenoar.aloudrite.ReadingSpeedConfigurable"/>
    </extensions>

    <projectListeners>
        <listener class="com.ritenoar.aloudrite.ReadingTabListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="com.ritenoar.aloudrite.ReadingProjectListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <!-- The shortcuts are given to the default keymaps of Linux and macOS only, on macOS with Cmd for Ctrl, since
             Ctrl+Option+Shift+Space does not reach the IDE there. "Default for GNOME" and "Default for KDE" take them
             from "Default for XWin". The keymaps that derive from "Mac OS X 10.5+" would take them as well, so they
             are removed there. None is given to $default, from which every other keymap derives -->
        <group id="com.ritenoar.aloudrite.ReadingButtonGroup">
            <action id="com.ritenoar.aloudrite.ReadAloud" class="com.ritenoar.aloudrite.ReadAloudAction"
                    text="Read Aloud, Pause or Resume" icon="com.ritenoar.aloudrite.AloudRiteIcons.ReadAloud">
                <keyboard-shortcut keymap="Default for XWin" first-keystroke="ctrl alt shift SPACE"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift SPACE"/>
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt shift SPACE" remove="true"/>
                <keyboard-shortcut keymap="Sublime Text (Mac OS X)" first-keystroke="meta alt shift SPACE" remove="true"/>
                <keyboard-shortcut keymap="Eclipse (Mac OS X)" first-keystroke="meta alt shift SPACE" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt shift SPACE" remove="true"/>
            </action>
            <action id="com.ritenoar.aloudrite.StopReading" class="com.ritenoar.aloudrite.StopReadingAction"
                    text="Stop Reading" icon="AllIcons.Actions.Suspend">
                <keyboard-shortcut keymap="Default for XWin" first-keystroke="ctrl alt shift O"/>
                <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift O"/>
                <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt shift O" remove="true"/>
                <keyboard-shortcut keymap="Sublime Text (Mac OS X)" first-keystroke="meta alt shift O" remove="true"/>
                <keyboard-shortcut keymap="Eclipse (Mac OS X)" first-keystroke="meta alt shift O" remove="true"/>
                <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt shift O" remove="true"/>
            </action>
        </group>
        <action id="com.ritenoar.aloudrite.ReadingButtons" class="com.ritenoar.aloudrite.ReadingButtonsAction"
                text="AloudRite Reading Buttons">
            <add-to-group group-id="EditorTabsToolbarActions"/>
        </action>
        <action id="com.ritenoar.aloudrite.ReadSlower" class="com.ritenoar.aloudrite.ReadSlowerAction"
                text="Read Slower" icon="AllIcons.General.Remove">
            <keyboard-shortcut keymap="Default for XWin" first-keystroke="ctrl alt shift COMMA"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift COMMA"/>
            <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt shift COMMA" remove="true"/>
            <keyboard-shortcut keymap="Sublime Text (Mac OS X)" first-keystroke="meta alt shift COMMA" remove="true"/>
            <keyboard-shortcut keymap="Eclipse (Mac OS X)" first-keystroke="meta alt shift COMMA" remove="true"/>
            <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt shift COMMA" remove="true"/>
        </action>
        <action id="com.ritenoar.aloudrite.ReadFaster" class="com.ritenoar.aloudrite.ReadFasterAction"
                text="Read Faster" icon="AllIcons.General.Add">
            <keyboard-shortcut keymap="Default for XWin" first-keystroke="ctrl alt shift PERIOD"/>
            <keyboard-shortcut keymap="Mac OS X 10.5+" first-keystroke="meta alt shift PERIOD"/>
            <keyboard-shortcut keymap="macOS System Shortcuts" first-keystroke="meta alt shift PERIOD" remove="true"/>
            <keyboard-shortcut keymap="Sublime Text (Mac OS X)" first-keystroke="meta alt shift PERIOD" remove="true"/>
            <keyboard-shortcut keymap="Eclipse (Mac OS X)" first-keystroke="meta alt shift PERIOD" remove="true"/>
            <keyboard-shortcut keymap="Visual Studio OSX" first-keystroke="meta alt shift PERIOD" remove="true"/>
        </action>
    </actions>
</idea-plugin>
