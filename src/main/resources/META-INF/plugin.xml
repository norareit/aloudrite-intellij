<idea-plugin>
    <id>com.ritenoar.aloudrite</id>
    <name>AloudRite</name>
    <vendor>Ritenoar</vendor>
    <description>Reads Markdown and agentic coding documents aloud inside the IDE.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="AloudRite" displayType="BALLOON"/>
        <toolWindow id="AloudRite" anchor="right" icon="/icons/toolWindow.svg" doNotActivateOnStart="true"
                    factoryClass="com.ritenoar.aloudrite.ReadingToolWindowFactory"/>
        <applicationConfigurable parentId="tools" id="com.ritenoar.aloudrite.ReadingSpeed" displayName="AloudRite"
                                 instance="com.ritenoar.aloudrite.ReadingSpeedConfigurable"/>
    </extensions>

    <projectListeners>
        <listener class="com.ritenoar.aloudrite.ReadingTabListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>

    <applicationListeners>
        <listener class="com.ritenoar.aloudrite.ReadingProjectListener"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <group id="com.ritenoar.aloudrite.ReadingButtonGroup">
            <action id="com.ritenoar.aloudrite.ReadAloud" class="com.ritenoar.aloudrite.ReadAloudAction"
                    text="Read Aloud" icon="com.ritenoar.aloudrite.AloudRiteIcons.ReadAloud"/>
            <action id="com.ritenoar.aloudrite.StopReading" class="com.ritenoar.aloudrite.StopReadingAction"
                    text="Stop Reading" icon="AllIcons.Actions.Suspend"/>
        </group>
        <action id="com.ritenoar.aloudrite.ReadingButtons" class="com.ritenoar.aloudrite.ReadingButtonsAction"
                text="AloudRite Reading Buttons">
            <add-to-group group-id="EditorTabsToolbarActions"/>
        </action>
    </actions>
</idea-plugin>
