<idea-plugin>
    <id>com.ritenoar.aloudrite</id>
    <name>AloudRite</name>
    <vendor>Ritenoar</vendor>
    <description>Reads Markdown and agentic coding documents aloud inside the IDE.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="AloudRite" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="com.ritenoar.aloudrite.ReadAloud" class="com.ritenoar.aloudrite.ReadAloudAction"
                text="Read Aloud" icon="/icons/readAloud.svg">
            <add-to-group group-id="EditorTabsToolbarActions"/>
        </action>
    </actions>
</idea-plugin>
